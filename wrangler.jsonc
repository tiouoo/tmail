{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tmail",
  "main": "src/worker/index.js",
  "compatibility_date": "2026-11-07",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "triggers": { "crons": ["*/15 * * * *"] },
}
