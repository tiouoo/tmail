# Copy to .env for Vite / Node.js, or .dev.vars for Wrangler. Never commit real values.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=
# Generate once: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# Use the SAME value on Vercel and Cloudflare. Minimum 32 characters.
SESSION_SECRET=
EMAIL_DOMAINS=t.example.com,t.example.org
FORWARD_TO=your-mailbox@qq.com
ARCHIVE_RECIPIENT=archive@example.com
SITE_PASSWORD=
# Optional secret inbox entry: /<path>/<password>. Server-only; never use VITE_ prefixes.
PRIVATE_MAIL_PATH=
PRIVATE_MAIL_PASSWORD=
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=mail.example.com
# Optional feature overrides (also configurable in config.js)
TEMPORARY_MAIL_ENABLED=true
FORWARD_ENABLED=true
ARCHIVE_ENABLED=true
CLEANUP_ENABLED=true
